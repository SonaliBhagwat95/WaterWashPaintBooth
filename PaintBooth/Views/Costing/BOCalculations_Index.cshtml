@model List<PaintBooth.Models.BOCalculationListViewModel>
@{
    ViewData["Title"] = "BO Calculations";
    //ViewBag.ActivePage = "BO Calculations";
}

@section Styles {
    <link rel="stylesheet" href="~/css/bo.css" asp-append-version="true" />
}

<!-- ── PAGE HEADER ──────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <div class="page-header-title">BO Calculations</div>
        <div class="page-header-sub">
            Bought-out cost records —
            <strong>@Model.Count</strong> record(s)
        </div>
    </div>
    <a asp-controller="Costing" asp-action="BOCalculations_Create" class="btn-pb-primary">
        <i class="bi bi-plus-lg"></i> New BO Calculation
    </a>
</div>

<!-- ── ALERTS ───────────────────────────────────────────────── -->
@if (TempData["Success"] != null)
{
    <div class="pb-alert pb-alert-success mb-3" data-auto-dismiss>
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<!-- ── TABLE CARD ────────────────────────────────────────────── -->
<div class="pb-card">

    <div class="setting-toolbar">
        <div class="setting-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="boSearch" class="setting-search"
                   placeholder="Search by enquiry code or company..." />
        </div>
        <div class="setting-count">
            <span id="visibleCount">@Model.Count</span> records
        </div>
    </div>

    <div class="setting-table-wrap">
        <table class="pb-table" id="boTable">
            <thead>
                <tr>
                    <th style="width:50px;">Sr.</th>
                    <th>Enquiry Code</th>
                    <th>Company</th>
                    <th style="text-align:right;">Cost of RM (₹)</th>
                    <th style="text-align:right;">Cost of BO (₹)</th>
                    <th>Approved</th>
                    <th>Date</th>
                    <th style="width:90px; text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div class="setting-empty">
                                <i class="bi bi-calculator"></i>
                                No BO calculation records found
                                <div class="setting-empty-sub">
                                    Click "New BO Calculation" to start
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int i = 0;
                    foreach (var item in Model)
                    {
                        i++;
                        <tr class="bo-row">
                            <td class="setting-sr">@i</td>
                            <td>
                                <span class="setting-code">@item.SalesNO</span>
                            </td>
                            <td style="color:var(--text-secondary);">
                                @item.CompanyName
                            </td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums;">
                                @item.TotalPriceOfRM.ToString("N0")
                            </td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums;">
                                <strong style="color:var(--accent);">
                                    @item.TotalPriceOfBO.ToString("N0")
                                </strong>
                            </td>
                            <td>
                                @if (item.IsPriceBidApproved)
                                {
                                    <span style="color:var(--success);font-size:12px;font-weight:600;">
                                        <i class="bi bi-check-circle-fill"></i> Approved
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">
                                        <i class="bi bi-clock"></i> Pending
                                    </span>
                                }
                            </td>
                            <td style="color:var(--text-muted); font-size:12px;">
                                @item.CreatedDate?.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <div class="setting-actions">
                                    <!-- ✅ Fix — correct action name -->
                                    <a asp-controller="Costing"
                                       asp-action="BOCalculations_Create"
                                       asp-route-enquiryCode="@item.SalesNO"
                                       class="setting-btn-edit"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/bo-index.js" asp-append-version="true"></script>
}
