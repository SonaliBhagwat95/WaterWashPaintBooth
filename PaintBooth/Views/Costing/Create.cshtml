                                    <input type="number" class="pb-input rm-inline" data-f="qty"
                                           value="@item.Qty.ToString("F0")" min="0" step="1" />
                                </td>
                                <td class="num">
                                    <input type="number" class="pb-input rm-inline" data-f="uw"
                                           value="@item.UnitWeight.ToString("F2")" min="0" step="0.01" />
                                </td>
                                <td class="num rm-tw">
                                    <input type="number" class="pb-input rm-inline" data-f="tw"
                                           value="@item.TotalWeight.ToString("F0")" min="0" step="1" />
                                </td>
                                @* <td class="num">
                                    <input type="number" class="pb-input rm-inline" data-f="rate"
                                           value="@item.Rate.ToString("F0")" min="0" step="0.01" />
                                </td> *@
                                <td class="num">
                                    <input type="number" class="pb-input rm-inline additional-rate" data-f="rate"
                                           value="@item.Rate.ToString("F0")" min="0" step="0.01" />
                                    <div class="rate-status" style="display:none;"></div>
                                </td>
                                <td class="num rm-amt">@item.Amount.ToString("N0")</td>
                                <td>
                                    <button type="button" class="btn-comp-del"
                                            data-row="@i" title="Remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot id="compFooter"
                       style="@(Model.AdditionalRMList != null && Model.AdditionalRMList.Any() ? "" : "display:none;")">
                    <tr>
                        <td colspan="5" style="text-align:right;">Total</td>
                        <td class="num" id="compTotalWeight">
                            @Model.AddRMWeight.ToString("F0")
                        </td>
                        <td></td>
                        <td class="num" id="compTotalAmount">
                            @Model.AddRMCost.ToString("N0")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ── ADD RAW MATERIAL MODAL ──────────────────────────────── -->
    <div id="addComponentModal" class="cost-modal-backdrop">
        <div class="cost-modal">
            <div class="cost-modal-header">
                <div class="cost-modal-title">
                    <i class="bi bi-plus-circle"></i>
                    Add Raw Material
                </div>
                <button type="button" id="btnCloseModal" class="cost-modal-close" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="pb-form-group">
                <label class="pb-label">Description</label>
                <input type="text" class="pb-input" id="compDesc"
                       placeholder="e.g. MS Plate 8mm, MS Angle 50×50×5"
                       autocomplete="off" />
                <div class="cost-field-err" id="errDesc">Description is required</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Quantity</label>
                        <input type="number" class="pb-input" id="compQty"
                               placeholder="0" min="0" step="1" />
                        <div class="cost-field-err" id="errQty">Enter a valid quantity</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Unit Weight (kg)</label>
                        <input type="number" class="pb-input" id="compUnitWeight"
                               placeholder="0.00" min="0" step="0.01" />
                        <div class="cost-field-err" id="errUW">Enter a valid weight</div>
                    </div>
                </div>
            </div>

            <div class="pb-form-group">
                <label class="pb-label">Item Code</label>
                <input type="text" class="pb-input additional-item-code" id="boCompItemCode"
                       placeholder="Enter Item Code" autocomplete="off" />
                <div class="cost-field-err" id="boErrItemCode">Enter a valid Item Code</div>
                <div class="rate-status" style="display:none;"></div>
            </div>

            <div class="pb-form-group">
                <label class="pb-label">Rate (₹ per kg)</label>
                <input type="number" class="pb-input additional-rate" id="compRate"
                       placeholder="0.00" min="0" step="0.01" readonly />
                <div class="cost-field-err" id="errRate">Enter a valid rate</div>
            </div>


            <!-- Live calc preview -->
            <div id="compCalcPreview" class="cost-calc-preview" style="display:none;">
                <span class="ccp-label">Calculated</span>
                <div class="ccp-values">
                    <div class="ccp-group">
                        <span class="ccp-sub">Total weight</span>
                        <span class="ccp-val" id="prevWeight">0.00 kg</span>
                    </div>
                    <div class="ccp-group">
                        <span class="ccp-sub">Amount</span>
                        <span class="ccp-val" id="prevAmount">₹0</span>
                    </div>
                </div>
            </div>

            <div class="cost-modal-footer">
                <button type="button" id="btnCancelModal" class="btn-pb-secondary">
                    Cancel
                </button>
                <button type="button" id="btnConfirmAdd" class="btn-pb-primary">
                    <i class="bi bi-check-lg"></i> Add to List
                </button>
            </div>
        </div>
    </div>
    <!-- ── SECTION 4: COST SUMMARY + SAVE ─────────────────────── -->
    <div class="pb-card mb-3">
        <div class="form-section-title">
            <i class="bi bi-calculator"></i>
            Cost Summary
        </div>

        <!-- Summary cards -->
        <div class="cost-summary-grid mb-4">
            <div class="cost-summary-card">
                <div class="cs-label">RM Weight of Panels (kg)</div>
               @*  <div class="cs-value" id="dispRMWeightPanels">
                    @Model.RMWeightOfPanels.ToString("F0")
                </div> *@
                <div class="cs-value" id="dispRMWeightPanels">
                    @rmWeightPanelsCombined.ToString("F0")
                </div>
            </div>
            <div class="cost-summary-card">
                <div class="cs-label">Total Cost of Panels (₹)</div>
                <div class="cs-value" id="dispTotalCostPanels">
                    @Model.TotalPriceofPanels.ToString("N0")
                </div>
            </div>
            <div class="cost-summary-card">
                <div class="cs-label">RM Weight of Frame (kg)</div>
                <div class="cs-value" id="dispRMWeightFrame">
                    @Model.TotalWeightOfFrame.ToString("F0")
                </div>
            </div>
            <div class="cost-summary-card">
                <div class="cs-label">Total Cost of Frame (₹)</div>
                <div class="cs-value" id="dispTotalCostFrame">
                    @Model.TotalPriceofFrame.ToString("N0")
                </div>
            </div>

            <!-- after the existing 5 cards, before closing </div> of cost-summary-grid -->
            <div class="cost-summary-card">
                <div class="cs-label">Additional RM Weight (kg)</div>
                <div class="cs-value" id="dispAddRMWeight">
                    @Model.AddRMWeight.ToString("F0")
                </div>
            </div>
            <div class="cost-summary-card">
                <div class="cs-label">Additional RM Cost (₹)</div>
                <div class="cs-value" id="dispAddRMCost">
                    @Model.AddRMCost.ToString("N0")
                </div>
            </div>



            <div class="cost-summary-card success">
                <div class="cs-label">Total Cost of RM (₹)</div>
                <div class="cs-value" id="dispTotalRM">
                    @Model.TotalCostOfRawMaterials.ToString("N0")
                </div>
            </div>
        </div>

        <!-- Save form -->
        <form asp-action="SaveCosting"
              asp-controller="Costing"
              method="post"
              id="costingForm">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="RMWeightOfPanels"
                   id="hRMWeightOfPanels" />
            <input type="hidden" asp-for="TotalPriceofPanels"
                   id="hTotalPriceofPanels" />
            <input type="hidden" asp-for="TotalWeightOfFrame"
                   id="hTotalWeightOfFrame" />
            <input type="hidden" asp-for="TotalPriceofFrame"
                   id="hTotalPriceofFrame" />
            <input type="hidden" asp-for="TotalCostOfRawMaterials"
                   id="hTotalCostOfRawMaterials" />
            <input type="hidden" id="hAddRMWeight" name="AddRMWeight"
                   value="@Model.AddRMWeight.ToString("F0")" />
            <input type="hidden" id="hAddRMCost" name="AddRMCost"
                   value="@Model.AddRMCost.ToString("F0")" />

            <div class="form-btn-row">
                <button type="submit" id="btnSave" class="btn-pb-primary">
                    <div class="btn-spinner"></div>
                    <span class="btn-text">
                        <i class="bi bi-floppy"></i> Save Costing
                    </span>
                </button>

                <button type="button" id="btnExport" class="btn-pb-secondary">
                    <i class="bi bi-file-earmark-excel"></i>
                    Export FI Sheet
                </button>

                <a asp-controller="Costing" asp-action="Index"
                   class="btn-pb-secondary">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script src="~/js/costing.js" asp-append-version="true"></script>
    <script>
        // ── Auto-fetch rate when user types an Item Code (grid rows + Add BO modal) ──
        $(document).on('blur', '.additional-item-code', function () {
            var $input = $(this);
            var itemCode = $input.val().trim();
            if (!itemCode) return;

            var $row = $input.closest('tr');
            var isModal = $row.length === 0; // no <tr> ancestor → modal context

            // Find the matching rate field: within the row for grids,
            // within the modal form-group siblings for the modal
            var $rateInput = isModal
                ? $input.closest('.cost-modal').find('.additional-rate')
                : $row.find('.additional-rate');

            var $statusEl = isModal
                ? $input.closest('.pb-form-group').find('.rate-status')
                : $row.find('.rate-status');

            var lastKnownRate = parseFloat($rateInput.data('last-rate')) || 0;

            $.getJSON('@Url.Action("GetItemRate", "Costing")',
                { itemCode: itemCode },
                function (res) {
                    if (res.success) {
                        $rateInput.val(res.rate.toFixed(2));
                        $input.removeClass('rate-fallback-warning');
                        $rateInput.data('last-rate', res.rate);
                        $statusEl.text('').hide();
                    } else {
                        $rateInput.val(isModal ? '' : lastKnownRate.toFixed(2));
                        $input.addClass('rate-fallback-warning');
                        $statusEl.text('⚠ ' + (res.message || 'Item not found — using last saved rate')).show();
                    }
                    $rateInput.trigger('input');
                }
            ).fail(function () {
                $rateInput.val(isModal ? '' : lastKnownRate.toFixed(2));
                $input.addClass('rate-fallback-warning');
                $statusEl.text('⚠ API unreachable — using last saved rate').show();
                $rateInput.trigger('input');
            });
        });
    </script>

    <script>
        $(function () {
            initAutocomplete('@Url.Action("SearchEnquiryCode", "Costing")');
            initSearch('@Url.Action("SearchByEnquiryID", "Costing")');
            initSave();
            initExport('@Url.Action("ExportFISheet", "Costing")');
            initAlerts();
            initComponents();  // ← add this
        });
            // ── Collapsible grid cards ──────────────────────────────
        (function initCollapsibleCards() {
            $('.pb-card').has('table.cost-table').each(function () {
                var $card  = $(this);
                var $title = $card.children('.form-section-title').first();
                if (!$title.length) return;
                $card.addClass('collapsible');
                if (!$title.find('.collapse-chevron').length) {
                    $title.append('<i class="bi bi-chevron-down collapse-chevron"></i>');
                }
            });

            // ignore clicks on the "Add Raw Material" button etc. inside a title
            $(document).on('click', '.pb-card.collapsible > .form-section-title', function (e) {
                if ($(e.target).closest('button, a').length) return;
                $(this).closest('.pb-card').toggleClass('collapsed');
            });
        })();
    </script>
}
