            Panel Details
            <span class="cost-row-count">
                <span id="panelCount">@panelList.Count</span> panels
            </span>
        </div>

        <div class="cost-table-wrap">
            <table class="cost-table" id="panelTable">
                <thead>
                    <tr>
                        <th style="width:54px;">Item</th>
                        <th>Panel Position</th>
                        <th class="num" style="text-align:center;">Panel Width</th>
                        <th class="num" style="text-align:center;">Panel Length</th>
                        <th class="num" style="text-align:center;">Thickness</th>
                        <th class="num" style="text-align:center;">No. of Panels</th>
                        <th class="num">Weight (kg)</th>
                        <th class="num">Gross Weight (kg)</th>
                    </tr>
                </thead>
                <tbody id="panelTableBody">
                    @if (!panelList.Any())
                    {
                        <tr id="panelEmptyRow">
                            <td colspan="7">
                                <div class="cost-empty">
                                    <i class="bi bi-inbox"></i>
                                    Search an enquiry to load panel data
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 0;
                        foreach (var item in panelList)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>
                                    @(string.IsNullOrEmpty(item.DisplayPanelPosition)
                                                                ? item.PanelPosition
                                                                : item.DisplayPanelPosition)
                        </td>
                        <td class="num" style="text-align:center;">@item.StandardPanelWidthForD.ToString("F0")</td>
                        <td class="num" style="text-align:center;">@item.EqualPanelWidthByH.ToString("F0")</td>
                        <td class="num" style="text-align:center;">@item.SheetThickness.ToString("F1")</td>
                        <td class="num" style="text-align:center;">@item.NoofPanels</td>
                        <td class="num">@item.PanelWeight.ToString("F2")</td>
                        <td class="num">@((item.PanelWeight * 1.10).ToString("F2"))</td>
                    </tr>
                                        }
                    }
                </tbody>
                @if (panelList.Any())
                {
                    <tfoot>
                        <tr>
                            <td colspan="6" style="text-align:right;">
                                Total Panel Weight
                            </td>
                            <td class="num" id="panelTotalWeight">
                                @panelList.Sum(x => x.PanelWeight).ToString("F0")
                            </td>
                            <td class="num" id="panelTotalGrossWeight">
                                @panelList.Sum(x => x.PanelWeight * 1.10).ToString("F0")
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

