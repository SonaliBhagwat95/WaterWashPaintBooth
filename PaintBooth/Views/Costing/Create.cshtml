
@model PaintBooth.Models.CostingModel
@{
    ViewData["Title"] = "Raw Material Costing";
    ViewBag.ActivePage = "Raw Material Costing";
    var isEdit = Model.DetailsList != null && Model.DetailsList.Any();

    var frameList = Model.FilteredDetailsList
                    ?? new List<PaintBooth.Models.PaintBoothModel>();

    var ductList = Model.ExhaustDuctingList != null && Model.ExhaustDuctingList.Any()
        ? Model.ExhaustDuctingList
        : new List<ExhaustDuctingModel>();

    var ductNetTotal = (double)ductList.Sum(x => x.DuctNetWeight);
    var rmWeightPanelsCombined = Model.RMWeightOfPanels + ductNetTotal;

    Func<PaintBooth.Models.PaintBoothModel, bool> isMetalBaffle = x =>
!string.IsNullOrEmpty(x.PanelPosition) && x.PanelPosition.StartsWith("MetalBaffle");

    var mbList = isEdit
        ? Model.DetailsList.Where(isMetalBaffle).ToList()
        : new List<PaintBooth.Models.PaintBoothModel>();


    // ⚠ Adjust this to match how EC panels are stored in PanelPosition.
    //   StartsWith("EC")  →  "EC1", "EC2", ...
    //   == "ExtractionChamber"  →  exact value
    //   .Contains("EC")  →  anywhere in the string
    Func<PaintBooth.Models.PaintBoothModel, bool> isEcPanel = x =>
        !string.IsNullOrEmpty(x.PanelPosition) && x.PanelPosition.StartsWith("EC");


    // ⚠ Adjust to match how transition pieces are stored in PanelPosition.
    Func<PaintBooth.Models.PaintBoothModel, bool> isTransitionPiece = x =>
        !string.IsNullOrEmpty(x.PanelPosition) && x.PanelPosition.StartsWith("Transition");

    var tpList = isEdit
        ? Model.DetailsList.Where(isTransitionPiece).ToList()
        : new List<PaintBooth.Models.PaintBoothModel>();



    var panelList = isEdit
    ? Model.DetailsList
           .Where(x => x.PanelPosition != "TopStructureFrame"
                    && x.PanelPosition != "BaseStructureFrame"
                    && !isEcPanel(x)
                    && !isMetalBaffle(x)
                    && !isTransitionPiece(x))
           .ToList()
    : new List<PaintBooth.Models.PaintBoothModel>();

    var ecList = isEdit
        ? Model.DetailsList.Where(isEcPanel).ToList()
        : new List<PaintBooth.Models.PaintBoothModel>();

    

}
@section Styles {
    <link rel="stylesheet" href="~/css/costing.css" asp-append-version="true" />
}

<!-- ── PAGE HEADER ──────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <div class="page-header-title">Raw Material Costing</div>
        <div class="page-header-sub">
            Search an enquiry to load panel &amp; frame data
        </div>
    </div>
    <a asp-controller="Costing" asp-action="Index" class="btn-pb-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<!-- ── ALERTS ───────────────────────────────────────────────── -->
@if (TempData["Success"] != null)
{
    <div class="pb-alert pb-alert-success mb-3" data-auto-dismiss>
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<!-- ══════════════════════════════════════════════════════
     SECTION 1 — ENQUIRY SEARCH
══════════════════════════════════════════════════════ -->
<div class="pb-card mb-3">
    <div class="form-section-title">
        <i class="bi bi-search"></i>
        Enquiry Selection
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <div class="pb-form-group mb-0">
                <label class="pb-label">Enquiry Code</label>
                <div class="cost-autocomplete-wrap">
                    <input type="text"
                           class="pb-input"
                           id="txtEnquiryCode"
                           placeholder="Type enquiry code..."
                           autocomplete="off"
                           value="@Context.Session.GetString("EnquiryCode")" />
                    <div id="enquiryDropdown" class="cost-dropdown"></div>
                </div>
            </div>
        </div>
        <div class="col-md-auto">
            <button type="button" id="btnSearch" class="btn-pb-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
