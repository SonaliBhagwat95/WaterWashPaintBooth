@section Scripts {
    <script src="~/js/pricebid.js" asp-append-version="true"></script>
    <script>
        $(function () {
            initAutocomplete('@Url.Action("SearchEnquiryCode", "Costing")');
            initSearch('@Url.Action("FetchPriceBIDData", "Costing")');
            initCalculations();
            initApprove();
            initSave();
            initAlerts();
                initEncCalculator(
            '@Url.Action("SaveENCCalculation", "Costing")',
            '@Url.Action("GetENCCalculation", "Costing")'
        );
            @if (hasData)
            {
                    <text>
                    // Edit mode — data already loaded from model
                    // Show the form sections
                    $('#divBidForm').show();
                    $('#divApprove').show();

                    // Recalculate all derived fields from saved rate values
                    // (Weight/Value columns are auto-derived, costs are recalculated)
                    initEditMode();
                    </text>
            }
        });
    </script>
}
