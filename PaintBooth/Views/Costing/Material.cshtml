@model PaintBooth.Models.MaterialModel
@{
    ViewData["Title"] = "Material";
    bool isEdit = Model.MOCID > 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/material.css" asp-append-version="true" />
}

<!-- ── PAGE HEADER ──────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <div class="page-header-title">Material Master</div>
        <div class="page-header-sub">
            Manage MOC materials — density and rate configuration
        </div>
    </div>
</div>

<!-- ── ALERTS ───────────────────────────────────────────────── -->
@if (TempData["Success"] != null)
{
    <div class="pb-alert pb-alert-success mb-3" data-auto-dismiss>
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<div class="row g-3">

    <!-- ── LEFT: ADD / EDIT FORM ────────────────────────────── -->
    <div class="col-md-4">
        <div class="pb-card">
            <div class="form-section-title">
                <i class="bi bi-@(isEdit ? "pencil" : "plus-circle")"></i>
                @(isEdit ? "Edit Material" : "Add Material")
            </div>

            <form asp-action="SaveMaterials" asp-controller="Costing"
                  method="post" id="materialForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MOCID" />

                <div class="pb-form-group">
                    <label class="pb-label">
                        MOC <span class="req-star">*</span>
                    </label>
                    <input asp-for="MOCName"
                           class="pb-input"
                           id="txtMOC"
                           placeholder="e.g. G.I, MS, SS304"
                           autocomplete="off" />
                    <span asp-validation-for="MOCName" class="form-field-error"></span>
                </div>

                <div class="pb-form-group">
                    <label class="pb-label">
                        Density <span class="req-star">*</span>
                    </label>
                    <input asp-for="Density"
                           class="pb-input"
                           id="txtDensity"
                           placeholder="e.g. 7.85"
                           autocomplete="off" />
                    <span asp-validation-for="Density" class="form-field-error"></span>
                </div>

                <div class="pb-form-group">
                    <label class="pb-label">
                        Rate (₹) <span class="req-star">*</span>
                    </label>
                    <input asp-for="Rate"
                           class="pb-input"
                           id="txtRate"
                           placeholder="e.g. 75.00"
                           autocomplete="off" />
                    <span asp-validation-for="Rate" class="form-field-error"></span>
                </div>

                <div class="mat-form-actions">
                    <button type="submit" class="btn-pb-primary" id="btnSave">
                        <i class="bi bi-@(isEdit ? "check-lg" : "plus-circle")"></i>
                        @(isEdit ? "Update Material" : "Add Material")
                    </button>
                    @if (isEdit)
                    {
                        <a asp-action="Material" asp-controller="Costing"
                           class="btn-pb-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    }
                    else
                    {
                        <button type="reset" class="btn-pb-secondary" id="btnClear">
                            <i class="bi bi-arrow-counterclockwise"></i> Clear
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ── RIGHT: MATERIAL LIST ─────────────────────────────── -->
    <div class="col-md-8">
        <div class="pb-card">
            <div class="pb-card-header">
                <div class="pb-card-title">
                    <i class="bi bi-list-ul me-2" style="color:var(--accent);"></i>
                    Material List
                </div>
                <div class="mat-search-wrap">
                    <i class="bi bi-search"></i>
                    <input type="text" id="matSearch" class="mat-search"
                           placeholder="Search MOC..." />
                </div>
            </div>

            <div class="setting-table-wrap">
                <table class="pb-table" id="matTable">
                    <thead>
                        <tr>
                            <th style="width:50px;">Sr.</th>
                            <th>MOC</th>
                            <th style="text-align:right;">Density</th>
                            <th style="text-align:right;">Rate (₹)</th>
                            <th style="width:90px; text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.getmaterial == null || ((IEnumerable<dynamic>)ViewBag.getmaterial).Count() == 0)
                        {
                            <tr id="emptyRow">
                                <td colspan="5">
                                    <div class="setting-empty">
                                        <i class="bi bi-box-seam"></i>
                                        No materials added yet
                                        <div class="setting-empty-sub">
                                            Use the form to add a new material
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            int sr = 1;
                            foreach (var item in ViewBag.getmaterial)
                            {
                                <tr class="mat-row @(item.MOCID == Model.MOCID ? "mat-row-active" : "")">
                                    <td style="color:var(--text-muted);font-size:12px;">@sr</td>
                                    <td style="font-weight:600;">@item.MOC</td>
                                    <td style="text-align:right;color:var(--text-secondary);">
                                        @item.Density
                                    </td>
                                    <td style="text-align:right;">
                                        <span style="color:var(--accent);font-weight:600;">
                                            ₹ @item.Rate
                                        </span>
                                    </td>
                                    <td>
                                        <div class="setting-actions">
                                            <a asp-controller="Costing"
                                               asp-action="Material"
                                               asp-route-id="@item.MOCID"
                                               class="setting-btn-edit"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-controller="Costing"
                                                  asp-action="DeleteMaterial"
                                                  method="post"
                                                  style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.MOCID" />
                                                <button type="button"
                                                        class="setting-btn-delete mat-delete-btn"
                                                        title="Delete"
                                                        data-name="@item.MOC">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                sr++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/material.js" asp-append-version="true"></script>
}
