@model List<PaintBooth.Models.PriceBIDListViewModel>
@{
    ViewData["Title"] = "Price BID";
    //ViewBag.ActivePage = "Price BID";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pricebid.css" asp-append-version="true" />
}

<!-- ── PAGE HEADER ──────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <div class="page-header-title">Price BID</div>
        <div class="page-header-sub">
            Price bid records — <strong>@Model.Count</strong> record(s)
        </div>
    </div>
    <a asp-controller="Costing" asp-action="PriceBID_Create" class="btn-pb-primary">
        <i class="bi bi-plus-lg"></i> New Price BID
    </a>
</div>

<!-- ── ALERTS ───────────────────────────────────────────────── -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="pb-alert pb-alert-success mb-3" data-auto-dismiss>
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["ErrorMessage"]
    </div>
}

<!-- ── TABLE CARD ────────────────────────────────────────────── -->
<div class="pb-card">
    <div class="setting-toolbar">
        <div class="setting-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="bidSearch" class="setting-search"
                   placeholder="Search by enquiry code or company..." />
        </div>
        <div class="setting-count">
            <span id="visibleCount">@Model.Count</span> records
        </div>
    </div>

    <div class="setting-table-wrap">
        <table class="pb-table" id="bidTable">
            <thead>
                <tr>
                    <th style="width:50px;">Sr.</th>
                    <th>Enquiry Code</th>
                    <th>Company</th>
                    <th style="text-align:right;">PO Value (₹)</th>
                    <th style="text-align:right;">Offer Price (₹)</th>
                    <th>Confirmed</th>
                    <th style="width:90px; text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="setting-empty">
                                <i class="bi bi-currency-rupee"></i>
                                No price bid records found
                                <div class="setting-empty-sub">
                                    Click "New Price BID" to create one
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int i = 0;
                    foreach (var item in Model)
                    {
                        i++;
                        <tr class="pb-row">
                            <td class="setting-sr">@i</td>
                            <td><span class="setting-code">@item.SalesNO</span></td>
                            <td style="color:var(--text-secondary);">@item.CompanyName</td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums;">
                                @item.POVALUE.ToString("N0")
                            </td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums;">
                                <strong style="color:var(--accent);">
                                    @item.BestPrice.ToString("N0")
                                </strong>
                            </td>
                            <td>
                                @if (item.ConfirmPriceBID)
                                {
                                    <span style="color:var(--success);font-size:12px;font-weight:600;">
                                        <i class="bi bi-check-circle-fill"></i> Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">
                                        <i class="bi bi-clock"></i> Pending
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="setting-actions">
                                    <a asp-controller="Costing"
                                       asp-action="PriceBID_Create"
                                       asp-route-salesNO="@item.SalesNO"
                                       class="setting-btn-edit" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/pricebid-index.js" asp-append-version="true"></script>
}
