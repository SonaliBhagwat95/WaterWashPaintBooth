                        <td style="text-align:center;">@(++sr)</td>
                        <td>Type</td>
                        <td>Centrifugal Blower - @Model.BlowerDetails.MountingTypes</td>
                    </tr>
                    <tr><td></td><td>MOC</td><td>MS with Epoxy painting.</td></tr>
                    <tr><td></td><td>Exhaust Capacity</td><td>@Model.MaterialList?.EXhaustCapacity m³/hr</td></tr>
                    <tr><td></td><td>Motor Capacity</td><td>@Model.MaterialList?.MotorCapacity HP @Model.MaterialList?.MotorType Motor IE 3</td></tr>
                    <tr><td></td><td>Qty</td><td>@Model.ProposalDetails?.NoOfBlowers</td></tr>
                    <tr><td></td><td>Blower Mounting</td><td>1.6 mm thk MOC- M.S. rectangular to round transformation Piece with Blower supports MOC-MS</td></tr>
                    <tr>
                        <td></td>
                        <td>VFD</td>
                        <td>
                            <div class="prop-radio-group">
                                <label><input type="radio" name="vfd" value="Yes" />Provided.</label>
                                <label><input type="radio" name="vfd" value="No" checked /> Not Provided.</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>Manual Volume control damper</td>
                        <td>
                            <div class="prop-radio-group">
                                <label><input type="radio" name="vcd" value="Yes" /> Yes</label>
                                <label><input type="radio" name="vcd" value="No" checked /> No</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>Painting Inside & Outside</td>
                        <td>
                            M. S. surface: one coat of Primer + two coats of Synthetic enamel paint.
                            Paint shade as per BPEPL Standard – Customer to reconfirm
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="background:var(--bg-hover); font-weight:700; font-size:12px; letter-spacing:.4px;">
                            Lighting
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align:center;">@(++sr)</td>
                        <td>Lighting</td>
                        <td>@Model.MaterialList?.LightSubType @Model.MaterialList?.LightType</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>Illumination Level</td>
                        <td>@Model.MaterialList?.LuxLevel.ToString("N0") Lux for Booth from 1 meter of tube-light fixture.</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>Quantity</td>
                        <td>@Model.MaterialList?.LightSubType fixture with @Model.MaterialList?.LightType Lamp; Illumination Level inside Booth will be @Model.MaterialList?.LuxLevel.ToString("N0") Lux, @Model.MaterialList?.TubelightQuantity Nos.</td>
                    </tr>
                    @if (!isFrontOpen)
                    {
                        <tr>
                            <td style="text-align:center;">@(++sr)</td>
                            <td>Suction Filters</td>
                            <td>Suction filter will be provided 20-25 micron</td>
