@section Scripts {
    @* PDF library *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>

    @* FileSaver — must be before docx *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    @* docx UMD build — exposes window.docx globally *@
    <script src="https://unpkg.com/docx@7.8.2/build/index.umd.min.js"></script>

    @* our proposal logic — loaded AFTER all libraries above *@
    <script src="~/js/proposal.js" asp-append-version="true"></script>
    <script>
        $(function () {
            initAutocomplete('@Url.Action("SearchEnquiryCode", "Costing")');
            initPriceCalc();
            initAlerts();

            // ── Rotating Table show/hide ──
            $(document).on("change", "input[name='RotatingTable']", function () {
                $(".rotating-table-desc").toggle($(this).val() === "Yes");
            });

            @if (hasData)
            {
                    <text>
                    initPDF('@Model.ProposalDetails.SalesNO', '@(Model.PriceBIDDetails?.RevisionNo ?? 0)', '@DateTime.Now.ToString("dd/MM/yyyy")');
                    initWord({
                        salesNo        : '@Model.ProposalDetails.SalesNO',
                        companyName    : '@Model.ProposalDetails.CompanyName',
                        contactPerson  : '@Model.ProposalDetails.ContactPerson',
                        date           : '@DateTime.Now.ToString("dd/MM/yyyy")',
                        // Basis of Design
                        length         : '@Model.ProposalDetails.Length',
                        widthSize      : '@Model.ProposalDetails.WidthSize',
                        heightSize     : '@Model.ProposalDetails.HeightSize',
                        production     : '@Model.ProposalDetails.ProductionRequirement',
                        compWeight     : '@Model.ProposalDetails.ComponantWeight',
                        shifts         : '@Model.ProposalDetails.NumberofShifts',
                        effectiveHrs   : '@Model.ProposalDetails.EffectiveWorking',
                        workingDays    : '@Model.ProposalDetails.Workingdays',
                        paintType      : '@Model.ProposalDetails.TypeOfPaintName',
                        viscosity      : '@Model.ProposalDetails.Viscosity',
                        dft            : '@Model.ProposalDetails.DFT',
                        noOfColors     : '@Model.ProposalDetails.NoOfColors',
                        specificHeat   : '@Model.ProposalDetails.SpecificHeat',
                        compHandling   : '@Model.ProposalDetails.ComponantHandlingName',
                        cycleTime      : '@Model.ProposalDetails.CycleTime',
                        loadUnload     : '@Model.ProposalDetails.LoadingUnloading',
                        // Technical spec
                        boothType      : '@(Model.ProposalDetails.Category == "1" ? "Dry back paint booth" : "Water wash paint booth")',
                        boothW         : '@Model.MaterialList?.W',
                        boothD         : '@Model.MaterialList?.D',
                        boothH         : '@Model.MaterialList?.H',
                        boothD3        : '@Model.MaterialList?.D3',
                        ecHeight       : '@Model.ProposalDetails.ExtractionChamberHeight',
                        pbMaterial     : '@Model.MaterialList?.PaintBoothMaterial',
                        ecMaterial     : '@Model.MaterialList?.ECMaterials',
                        exhaustCap     : '@Model.MaterialList?.EXhaustCapacity',
                        motorCap       : '@Model.MaterialList?.MotorCapacity',
                        blowerMounting : '@Model.BlowerDetails.MountingTypes',
                        luxLevel       : '@Model.MaterialList?.LuxLevel',
                        lumens         : '@Model.MaterialList?.Lumens',
                        lightQty       : '@Model.MaterialList?.TubelightQuantity',
                        // Payment terms
                        advance        : '@FormatPct(Model.PaymentTerms?.AdvancedPercentage)',
                        dap            : '@FormatPct(Model.PaymentTerms?.DAPPercentage)',
                        supplyBefore   : '@FormatPct(Model.PaymentTerms?.SUPPLYBEFOREDISPATCHPercentage)',
                        supplyAfter    : '@FormatPct(Model.PaymentTerms?.SUPPLYAFTERDISPATCHPercentage)',
                        installation   : '@FormatPct(Model.PaymentTerms?.INSTALLATIONPercentage)',
                        commissioning  : '@FormatPct(Model.PaymentTerms?.COMMISSIONINGPercentage)',
                        delivery       : '@Model.PaymentTerms?.DeliverySupplyperiod',
                        erection       : '@Model.PaymentTerms?.EAndCPeriod',
                        // Price
                        poValue        : '@Model.PriceBIDDetails?.POVALUE',
                        encCost        : '@Model.PriceBIDDetails?.EAndCCost',
                        pandFCost      : '@Model.PriceBIDDetails?.PandFCost',
                        insurance      : '@Model.PriceBIDDetails?.Insurance'
                    });
                    </text>
            }
        });
    </script>
}
