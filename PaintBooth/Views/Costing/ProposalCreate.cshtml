                    </tr>
                    <tr>
                        <td style="text-align:center;">@(++sr)</td>
                        <td>Secondary Filters</td>
                        <td>
                            Paint Arrestance filter or Paper Filters supporting with MS mesh &amp; MS Structure.
                            <br />
                            <span style="display:inline-flex; gap:12px; align-items:flex-start; margin-top:8px; flex-wrap:wrap;">
                                <img src="~/img/TechnicalData.png" alt="Secondary Filter Technical Data"
                                     style="max-width:220px; height:auto;" />
                                <img src="~/img/PaintArrestedFilter.png" alt="Secondary Filter"
                                     style="max-width:220px; height:auto;" />
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="3" style="background:var(--bg-hover); font-weight:700; font-size:12px; letter-spacing:.4px;">
                            Exhaust Blower Specifications
                        </td>
                    </tr>
