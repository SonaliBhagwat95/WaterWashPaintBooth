@model PaintBooth.Models.ProposalPriceBIDViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Proposal";
    ViewBag.ActivePage = "Proposal";
    bool hasData = Model?.ProposalDetails != null;

    string FormatPct(decimal? v)
    {
        if (v == null) return "0";
        return v.Value == Math.Floor(v.Value)
            ? ((int)v.Value).ToString()
            : v.Value.ToString("G29");
    }


    // Value as entered, or "Not Specified" if empty
    string NS(object value)
    {
        var s = value?.ToString();
        return string.IsNullOrWhiteSpace(s) ? "Not Specified" : s.Trim();
    }

    // L × W × H — "Not Specified" only if all three are empty
    string NSDim(object l, object w, object h)
    {
        if (string.IsNullOrWhiteSpace(l?.ToString()) &&
            string.IsNullOrWhiteSpace(w?.ToString()) &&
            string.IsNullOrWhiteSpace(h?.ToString()))
            return "Not Specified";

        return $"{NS(l)} mm (L) × {NS(w)} mm (W) × {NS(h)} mm (H)";
    }


    double tubeLightKwEach = 0.06;
    double blowerKwEach = Math.Round((double)(Model.MaterialList?.MotorCapacity ?? 0m) * 0.746, 2);
    double blowerTotalKw = Math.Round(blowerKwEach * (double)(Model.ProposalDetails?.NoOfBlowers ?? 0), 2);
    double tubeLightTotalKw = Math.Round((double)(Model.MaterialList?.TubelightQuantity ?? 0) * tubeLightKwEach, 2);
    double totalElectricalKw = Math.Round(blowerTotalKw + tubeLightTotalKw, 2);
    var isFrontOpen = Model.ProposalDetails?.SubTypeOfDraftType == "Front Open";

    // Serial number counter for Technical Specification table
    int sr = 0;

    // Door line (computed here to keep Razor markup simple)
    var doorKind = (Model.ProposalDetails?.DoorSubType ?? "").Trim();
    string doorLine = string.IsNullOrEmpty(doorKind)
        ? "No Door Selected / Not Required"
        : doorKind == "Hinged" ? "Hinge Door will be provided"
        : doorKind == "Sliding" ? "Sliding Door will be provided"
        : doorKind + " Door will be provided";
    bool showDoorSize = !string.IsNullOrEmpty(doorKind)
                        && (Model.ProposalDetails?.DoorWidth ?? 0) > 0
                        && (Model.ProposalDetails?.DoorHeight ?? 0) > 0;

    // Image/Photo/Drawing (Basis of Design row 3)
    var imgPath = (Model.ProposalDetails?.ImagePath ?? "").Trim();
    bool hasImg = !string.IsNullOrEmpty(imgPath);
    var imgExt = hasImg ? System.IO.Path.GetExtension(imgPath).ToLowerInvariant() : "";
    bool isPicture = imgExt == ".png" || imgExt == ".jpg" || imgExt == ".jpeg"
                  || imgExt == ".gif" || imgExt == ".webp" || imgExt == ".bmp";
}


@section Styles {
    <link rel="stylesheet" href="~/css/proposal.css" asp-append-version="true" />
}

<!-- ── PAGE HEADER ──────────────────────────────────────────── -->
<div class="page-header">
    <div>
        <div class="page-header-title">Proposal</div>
        <div class="page-header-sub">Generate and download proposal document</div>
    </div>
    <a asp-controller="Costing" asp-action="ProposalIndex" class="btn-pb-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<!-- ── ALERTS ───────────────────────────────────────────────── -->
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<!-- ══════════════════════════════════════════════════════
     SECTION 1 — SEARCH
══════════════════════════════════════════════════════ -->
<div class="pb-card mb-3">
    <div class="form-section-title">
        <i class="bi bi-search"></i> Enquiry Selection
    </div>
    <form method="post"
          asp-controller="Costing"
          asp-action="ShowProposalForm"
          id="searchForm">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <div class="pb-form-group mb-0">
                    <label class="pb-label">Enquiry / Sales No.</label>
                    <div class="prop-autocomplete-wrap">
                        <input type="text" class="pb-input" id="txtSalesNO"
                               name="SalesNO"
                               placeholder="Type enquiry code..."
                               autocomplete="off"
                               value="@Model?.ProposalDetails?.SalesNO" />
                        <div id="propDropdown" class="prop-dropdown"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" id="btnSearch" class="btn-pb-primary">
                    <i class="bi bi-search"></i> Load Proposal
                </button>
            </div>
        </div>
    </form>
</div>

@if (hasData)
