@model List<PaintBooth.Models.PaintBoothListViewModel>
@{
    ViewData["Title"] = "Paintbooth Design";
}

@section Styles {
    <link rel="stylesheet" href="~/css/paintbooth.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="page-header-title">Paintbooth Design</div>
        <div class="page-header-sub">
            Paintbooth design calculations — <strong>@Model.Count</strong> record(s)
        </div>
    </div>
    <a asp-controller="PaintBoothDesign" asp-action="Create" class="btn-pb-primary">
        <i class="bi bi-plus-lg"></i> New Design
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="pb-alert pb-alert-success mb-3" data-auto-dismiss>
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<div class="pb-card">
    <div class="pb-toolbar">
        <div class="pb-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="pbSearch" class="pb-search-inp"
                   placeholder="Search by enquiry code..." />
        </div>
        <div style="font-size:12px;color:var(--text-muted);">
            <span id="visibleCount">@Model.Count</span> records
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="pb-table" id="pbTable">
            <thead>
                <tr>
                    <th style="width:50px;">Sr.</th>
                    <th>Enquiry Code</th>
                    <th>W (mm)</th>
                    <th>H (mm)</th>
                    <th>D (mm)</th>
                    <th>Blower Code</th>
                    <th>Motor Code</th>
                    <th style="width:90px;text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8">
                            <div style="text-align:center;padding:48px 0;color:var(--text-muted);">
                                <i class="bi bi-pentagon" style="font-size:36px;display:block;margin-bottom:12px;opacity:0.4;"></i>
                                No paintbooth designs yet
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int sr = 1;
                    @foreach (var item in Model)
                    {
                        <tr class="pb-data-row">
                            <td style="color:var(--text-muted);font-size:12px;">@sr</td>
                            <td style="font-weight:600;">@item.SalesNO</td>
                            <td>@item.W.ToString("F0")</td>
                            <td>@item.H.ToString("F0")</td>
                            <td>@item.D.ToString("F0")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BlowerItemCode))
                                {
                                    <code style="font-size:11px;color:var(--accent);">
                                        @item.BlowerItemCode
                                    </code>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.MotorItemCode))
                                {
                                    <code style="font-size:11px;color:var(--accent-2);">
                                        @item.MotorItemCode
                                    </code>
                                }
                            </td>
                            <td>
                                <div style="display:flex;justify-content:flex-end;gap:6px;">
                                    <a asp-controller="PaintBoothDesign"
                                       asp-action="Edit"
                                       asp-route-salesNo="@item.SalesNO"
                                       class="setting-btn-edit" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @* <form asp-controller="PaintBoothDesign"
                                          asp-action="Delete" method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="salesNo" value="@item.SalesNO" />
                                        <button type="button" class="setting-btn-delete"
                                                data-confirm="Delete design for @item.SalesNO?"
                                                data-url="/PaintBoothDesign/Delete/@item.SalesNO">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form> *@
                                </div>
                            </td>
                        </tr>
                        sr++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function(){
            $('#pbSearch').on('input',function(){
                var k=$(this).val().toLowerCase().trim(),v=0;
                $('#pbTable tbody tr.pb-data-row').each(function(){
                    if($(this).text().toLowerCase().indexOf(k)>-1){$(this).show();v++;}
                    else $(this).hide();
                });
                $('#visibleCount').text(v);
            });
        });
    </script>
}
