                               id="txtexhaustheight" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group">
                        <label class="pb-label pb-label-accent">
                            Duct Width (mm)
                        </label>
                        <input asp-for="ExhaustWidth" class="pb-input"
                               id="txtExhaustWidth" />
                    </div>
                </div>
                @* <div class="col-md-2">
                    <div class="pb-form-group">
                        <label class="pb-label pb-label-accent">
                            Duct Thickness (mm)
                        </label>
                        <input asp-for="ExhaustThickness" class="pb-input"
                               id="txtExhaustThickness" />
                    </div>
                </div> *@
                <div class="col-md-2">
                    <div class="pb-form-group">
                        <label class="pb-label pb-label-accent">
                            Duct Thickness (mm)
                        </label>
                        <input asp-for="ExhaustThickness" class="pb-input"
