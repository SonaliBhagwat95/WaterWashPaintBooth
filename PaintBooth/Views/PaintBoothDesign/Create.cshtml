                                (ref: Water Column)
                            </small>
                        </label>
                        <input type="number" id="txtStaticPressure"
                               class="pb-input" value="0" min="0" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Serial No. (0-9)</label>
                        <input type="number" id="txtBlowerSerial"
                               class="pb-input" value="0" min="0" max="9" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label pb-label-accent">
                            Generated Item Code
                        </label>
                        <input type="text" id="txtBlowerItemCode"
                               asp-for="BlowerItemCode"
                               class="pb-input pb-code-input" readonly />
                    </div>
                </div>
            </div>
            <div id="blowerCodeBreakdown" class="pb-code-breakdown mt-2"></div>
        </div>

        <!-- ── SECTION 12: Motor Item Code ───────────────────── -->
        <div class="pb-card mb-3" id="divMotorItemCode" style="display:none;">
            <div class="form-section-title">
                <i class="bi bi-gear"></i>
                Motor Item Code
            </div>
            <div class="row g-3 align-items-end">
