                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Phase</label>
                        <select id="drpMotorPhase" class="pb-select">
                            <option value="1">1 — Single Phase</option>
                            <option value="3" selected>3 — Three Phase</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">No. of Poles</label>
                        <select id="drpMotorPoles" class="pb-select">
                            <option value="2">2 Pole</option>
                            <option value="4" selected>4 Pole</option>
                            <option value="6">6 Pole</option>
                            <option value="8">8 Pole</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Flame Proof</label>
                        <input asp-for="MotorTypes" class="pb-input"
