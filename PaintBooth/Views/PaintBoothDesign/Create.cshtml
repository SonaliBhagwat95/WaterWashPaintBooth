                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Mounting Type</label>
                        <select id="drpMotorMount" class="pb-select">
                            <option value="1" selected>1 — Foot Mounted</option>
                            <option value="2">2 — Flange Mounted</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">IE Rating</label>
                        <select id="drpMotorIE" class="pb-select">
                            <option value="1">1 — IE1</option>
                            <option value="2" selected>2 — IE2</option>
                            <option value="3">3 — IE3</option>
                            <option value="4">4 — EFF1</option>
                            <option value="5">5 — EFF2</option>
                            <option value="6">6 — EFF3</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label">Serial No. (0-9)</label>
                        <input type="number" id="txtMotorSerial"
                               class="pb-input" value="0" min="0" max="9" />
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-3">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label pb-label-accent">
                            Generated Motor Item Code
                        </label>
                        <input type="text" id="txtMotorItemCode"
                               asp-for="MotorItemCode"
                               class="pb-input pb-code-input" readonly />
                    </div>
                </div>
            </div>
            <div id="motorCodeBreakdown" class="pb-code-breakdown mt-2"></div>
        </div>

        <!-- ── SUBMIT ─────────────────────────────────────────── -->
        <div class="form-btn-row">
            <button type="submit" id="submitbtn" class="btn-pb-primary" disabled>
                <div class="btn-spinner"></div>
                <span class="btn-text">
                    <i class="bi bi-arrow-right-circle"></i> Next
                </span>
            </button>
            <a asp-controller="PaintBoothDesign" asp-action="Index"
               class="btn-pb-secondary">
                <i class="bi bi-x-lg"></i> Cancel
            </a>
            <span id="SubmitError" class="form-field-error" style="display:none;">
                <i class="bi bi-exclamation-circle"></i>
                Please check above details before submitting.
            </span>
        </div>

    </div>
</form>

<!-- ── SETTING MODAL ─────────────────────────────────────────── -->
<div id="settingModalOverlay" class="pb-modal-overlay" style="display:none;">
    <div class="pb-modal">
        <div class="pb-modal-header">
            <span><i class="bi bi-gear me-2"></i> Setting Details</span>
            <button type="button" id="closeSettingModal" class="pb-modal-close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="pb-modal-body" id="settingModalContent">
        </div>
        <div class="pb-modal-footer">
            <button type="button" class="btn-pb-secondary" id="closeSettingModal2">
                Close
            </button>
        </div>
    </div>
</div>

