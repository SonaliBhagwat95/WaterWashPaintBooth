            <div class="form-section-title">
                <i class="bi bi-lightning-charge"></i>
                Blower Power Calculations
            </div>
            <div class="row g-3 align-items-center mb-3">
                <div class="col-md-auto">
                    <button type="button" id="btnWaterColumn"
                            class="btn-pb-secondary">
                        <i class="bi bi-droplet"></i> Water Column
                    </button>
                </div>


            </div>

            <!-- Pressure Drop Table -->
            <div id="pressureDropSection" style="display:none;">
                <table class="pb-table" id="pressureDropTable">
                    <thead>
                        <tr>
                            <th style="width:50px;">Select</th>
                            <th style="width:70px;">Item No.</th>
                            <th>Description</th>
                            <th style="width:100px;">Pressure Drop (mm)</th>
                            <th style="width:80px;">Quantity</th>
                            <th style="width:80px;">Total</th>
                        </tr>
                    </thead>
                    <tbody id="pressureDropBody"></tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" style="text-align:right;font-size:13px;color:var(--text-secondary);">
                                Addition Factor:
                            </td>
                            <td>
                                <input type="number" value="10" id="additionFactor"
                                       class="pb-input" style="width:80px;" />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" style="text-align:right;font-weight:600;color:var(--text-primary);">
                                Grand Total:
                            </td>
                            <td id="grandTotal"
                                style="text-align:center;font-weight:700;color:var(--accent);">
                                0.00
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label pb-label-accent">
                            Water Column (mm)
                        </label>
                        @*  <input asp-for="WaterColumn" class="pb-input"
                               id="txtWater" /> *@
                        <input asp-for="WaterColumn" class="pb-input" id="txtWater" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <label class="pb-label pb-label-accent">
                            Blower HP
                        </label>
                        @* <input asp-for="BlowerHpCalculation" class="pb-input"
                               id="txtHPCalculations" readonly /> *@
                        <input asp-for="BlowerHpCalculation" class="pb-input" id="txtHPCalculations" readonly />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="pb-form-group mb-0">
                        <button type="button" id="btnFetchRecords"
                                class="btn-pb-secondary" style="margin-top:23px" disabled>
                            <i class="bi bi-cpu"></i> Motor Details
                        </button>
                    </div>
                </div>
            </div>
            <!-- Motor Table -->
            <div id="motorTableSection" style="display:none;margin-top:16px;">
                <table class="pb-table" id="motorFlangeTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Rated HP</th>
                            @*  <th>Frame Size</th> *@
                            <th>Type Ref</th>
                            <th>Rated Speed</th>
                            <th>Rated Current</th>
                            <th>Efficiency</th>
                            <th style="width:60px;">Select</th>
                        </tr>
                    </thead>
                    <tbody id="motorFlangeBody"></tbody>
                </table>
            </div>
        </div>

        <!-- ── SECTION 11: Blower Item Code ──────────────────── -->
