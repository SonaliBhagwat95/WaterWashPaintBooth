                </div>
                <div class="col-md-2">
                    <div class="pb-form-group">
                        <label class="pb-label pb-label-accent">
                            Blower Orientation
                        </label>
                        <select asp-for="BlowerOrientation" class="pb-select"
                                id="drpOrientaionBlower">
                            <option value="90">90°</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Ducting component add row -->
