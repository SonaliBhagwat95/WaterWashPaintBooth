            <div class="row g-3 mt-1">
                <!-- LEFT: compact grid of added components -->
                <div class="col-lg-7">
                    <div class="pb-duct-grid">
                        <table id="componentsTable" class="table pb-duct-table mb-0">
                            <thead>
                                <tr>
                                    <th style="width:50px;">Sr.</th>
