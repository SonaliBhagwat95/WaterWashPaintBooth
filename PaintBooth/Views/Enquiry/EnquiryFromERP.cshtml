@model List<PaintBooth.Models.ERP.FrappeOpportunityData>
@{
    ViewData["Title"] = "Enquiry From ERP";
}

@section Styles {
    <link rel="stylesheet" href="~/css/enquiry.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <div class="page-header-title">Enquiry From ERP</div>
        <div class="page-header-sub">
            Opportunities fetched from ERP — <strong>@Model.Count</strong> record(s)
        </div>
    </div>
    <a asp-controller="Enquiry" asp-action="Index" class="btn-pb-primary">
        <i class="bi bi-arrow-left"></i> Back to Enquiry
    </a>
</div>
<div class="pb-card mb-3">
    <form method="get" asp-controller="Enquiry" asp-action="EnquiryFromERP" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="pb-label">Search Enquiry ID</label>
            <input type="text" name="searchEnquiryId" id="searchEnquiryId" class="pb-input" placeholder="Search by Enquiry ID" onkeydown="if(event.key==='Enter'){event.preventDefault();}" />
        </div>

        <div class="col-md-3">
            <label class="pb-label">Start Date</label>
            <input type="date" name="startDate" class="pb-input"
                   value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3">
            <label class="pb-label">End Date</label>
            <input type="date" name="endDate" class="pb-input"
                   value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn-pb-primary">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </div>
        @if (ViewBag.StartDate != null || ViewBag.EndDate != null)
        {
            <div class="col-md-auto">
                <a asp-action="EnquiryFromERP" class="btn-pb-secondary">
                    <i class="bi bi-x-lg"></i> Clear Filter
                </a>
            </div>
        }
    </form>
</div>
@if (TempData["Error"] != null)
{
    <div class="pb-alert pb-alert-danger mb-3" data-auto-dismiss>
        <i class="bi bi-exclamation-circle-fill"></i>
        @TempData["Error"]
    </div>
}

<div class="pb-card">
    <div class="enq-table-wrap">
        <table class="pb-table">
            <thead>
                <tr>
                    <th style="width:50px;">Sr.</th>
                    <th>Enquiry ID</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Modified Date</th>
                    <th>Submitted Enquiry Date</th>
                    <th>Amount</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9">
                            <div class="enq-empty">
                                <i class="bi bi-clipboard2-text"></i>
                                No enquiries found in ERP
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    int sr = 1;
                    int pageSize = 10;
                    @foreach (var opp in Model)
                    {
                        int pageNumber = ((sr - 1) / pageSize) + 1;
                        <tr class="enq-row" data-page="@pageNumber">
                            <td class="enq-sr">@sr</td>
                            <td class="enq-no">@opp.name</td>
                            <td class="enq-company">@opp.customer_name</td>
                            <td>
                                <span class="badge-status badge-inprogress">@opp.status</span>
                            </td>
                            <td class="enq-date">
                                @(opp.creation?.ToString("dd MMM yyyy, hh:mm:ss tt") ?? "-")
                            </td>
                            <td class="enq-date">
                                @(opp.modified?.ToString("dd MMM yyyy, hh:mm:ss tt") ?? "-")
                            </td>
                            <td class="enq-date">
                                @if (opp.SubmittedEnquiryDate.HasValue)
                                {
                                    <span class="badge-status badge-active">
                                        @opp.SubmittedEnquiryDate.Value.ToString("dd MMM yyyy tt")
                                    </span>
                                }
                                else
                                {
                                    <text>-</text>
                                }
                            </td>
                            <td>
                                @opp.opportunity_amount.ToString("N2")
                            </td>
                            <td>
                                <div class="enq-actions">
                                    <a asp-controller="Enquiry"
                                       asp-action="Create"
                                       asp-route-opportunityName="@opp.name"
                                       class="enq-btn-edit"
                                       title="Add Enquiry">
                                        <i class="bi bi-plus-circle"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        sr++;
                    }
                }
            </tbody>
        </table>

       
    </div>
    <div class="pb-card" style="margin-top:0; border-top:none; border-radius:0 0 10px 10px; padding:14px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
        <div id="paginationInfo" style="color:var(--text-secondary); font-size:13px;"></div>
        <div id="paginationControls" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;"></div>
    </div>
</div>
@section Scripts {
    <script>
        $(function () {
            var pageSize = 10;
            var currentPage = 1;
            var allRows = $('.enq-row').toArray();   // all rows, once
            var filteredRows = allRows;               // starts as full set

            function applySearch(term) {
                term = (term || '').trim().toLowerCase();

                if (!term) {
                    filteredRows = allRows;
                } else {
                    filteredRows = allRows.filter(function (row) {
                        var enquiryId = $(row).find('.enq-no').text().toLowerCase();
                        return enquiryId.indexOf(term) !== -1;
                    });
                }

                currentPage = 1;
                showPage(1);
            }

            function showPage(page) {
                currentPage = page;

                // Hide everything first
                $(allRows).hide();

                var totalRows = filteredRows.length;
                var totalPages = Math.ceil(totalRows / pageSize) || 1;

                if (currentPage > totalPages) currentPage = totalPages;

                var startIdx = (currentPage - 1) * pageSize;
                var pageRows = filteredRows.slice(startIdx, startIdx + pageSize);

                $(pageRows).show();

                var start = totalRows === 0 ? 0 : startIdx + 1;
                var end = Math.min(currentPage * pageSize, totalRows);

                $('#paginationInfo').text(
                    totalRows > 0
                        ? 'Showing ' + start + '–' + end + ' of ' + totalRows + ' enquiries'
                        : 'No matching enquiries found'
                );

                // Toggle "no results" row visibility if you have one — optional
                renderPageButtons(totalPages);
            }

            function renderPageButtons(totalPages) {
                var $controls = $('#paginationControls').empty();

                if (totalPages <= 1) return;

                $('<button type="button" class="pg-btn pg-nav">')
                    .html('<i class="bi bi-chevron-left"></i>')
                    .prop('disabled', currentPage === 1)
                    .on('click', function () { if (currentPage > 1) showPage(currentPage - 1); })
                    .appendTo($controls);

                var pages = getPageWindow(currentPage, totalPages);

                pages.forEach(function (p) {
                    if (p === '...') {
                        $('<span class="pg-ellipsis">…</span>').appendTo($controls);
                    } else {
                        $('<button type="button" class="pg-btn' + (p === currentPage ? ' pg-active' : '') + '">')
                            .text(p)
                            .on('click', function () { showPage(p); })
                            .appendTo($controls);
                    }
                });

                $('<button type="button" class="pg-btn pg-nav">')
                    .html('<i class="bi bi-chevron-right"></i>')
                    .prop('disabled', currentPage === totalPages)
                    .on('click', function () { if (currentPage < totalPages) showPage(currentPage + 1); })
                    .appendTo($controls);
            }

            function getPageWindow(current, total) {
                var delta = 2;
                var range = [];
                var rangeWithDots = [];
                var l;

                for (var i = 1; i <= total; i++) {
                    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
                        range.push(i);
                    }
                }

                range.forEach(function (i) {
                    if (l) {
                        if (i - l === 2) {
                            rangeWithDots.push(l + 1);
                        } else if (i - l > 2) {
                            rangeWithDots.push('...');
                        }
                    }
                    rangeWithDots.push(i);
                    l = i;
                });

                return rangeWithDots;
            }

            // ── Search box — live filter as user types ──
            $('#searchEnquiryId').on('input', function () {
                applySearch($(this).val());
            });

            // Initial render
            if (allRows.length > 0) {
                showPage(1);
            } else {
                $('#paginationInfo').text('');
                $('#paginationControls').empty();
            }
        });
    </script>
}