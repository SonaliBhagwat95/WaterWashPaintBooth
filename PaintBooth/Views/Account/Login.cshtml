@model PaintBooth.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – Bullows PaintBooth</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" />
</head>
<body>

    <!-- ── LEFT PANEL ───────────────────────────────────────── -->
    <div class="login-left">
        <div class="left-deco">
            <div class="deco-grid"></div>
            <div class="deco-circle deco-circle-1"></div>
            <div class="deco-circle deco-circle-2"></div>
        </div>
        <div class="left-content">
            <div class="brand-logo">
                <div class="brand-icon"><i class="bi bi-droplet-half"></i></div>
                <div class="brand-name">Paint<span>Booth</span> Pro</div>
            </div>
            <h1 class="left-headline">
                Manage Your<br />Booth Like a<br /><em>Pro.</em>
            </h1>
            <p class="left-sub">
                Complete paint shop management — from job intake to final delivery.
                Track vehicles, technicians, materials, and invoices in one place.
            </p>
            <div class="left-stats">
                <div>
                    <div class="left-stat-val">24<span>+</span></div>
                    <div class="left-stat-label">Active Jobs</div>
                </div>
                <div>
                    <div class="left-stat-val">98<span>%</span></div>
                    <div class="left-stat-label">On-Time Delivery</div>
                </div>
                <div>
                    <div class="left-stat-val">6<span>k+</span></div>
                    <div class="left-stat-label">Vehicles Done</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── RIGHT PANEL ──────────────────────────────────────── -->
    <div class="login-right">

        <button class="theme-btn" id="themeBtnLogin" type="button" title="Toggle theme">
            <i class="bi bi-sun-fill" id="themeIcon"></i>
        </button>

        <div class="form-card">

            <div class="form-header">
                <h2 class="form-title">Welcome back</h2>
                <p class="form-sub">Sign in to your Bullows account</p>
            </div>

            <!-- Error alert (shown by JS) -->
            <div class="alert-error" id="loginAlert" style="display:none;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span id="loginAlertMsg"></span>
            </div>

            <!-- Login Form -->
            <form id="loginForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="form-group">
                    <label class="form-label">Username</label>
                    <div class="input-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text"
                               id="Username"
                               name="Username"
                               class="form-control"
                               placeholder="Enter your username"
                               autocomplete="username" />
                    </div>
                    <div class="field-error" id="usernameError" style="display:none;">
                        <i class="bi bi-exclamation-circle"></i>
                        <span></span>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-pass" id="togglePassBtn">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <div class="field-error" id="passwordError" style="display:none;">
                        <i class="bi bi-exclamation-circle"></i>
                        <span></span>
                    </div>
                </div>

                <!-- Remember me -->
                @* <div class="form-options">
                    <label class="remember-label">
                        <input type="checkbox" id="RememberMe" name="RememberMe" />
                        Remember me
                    </label>
                </div> *@

                <!-- Submit button -->
                <button type="submit" class="btn-login" id="loginBtn">
                    <div class="btn-spinner"></div>
                    <span class="btn-text">
                        <i class="bi bi-arrow-right-circle"></i>
                        Sign In
                    </span>
                </button>

            </form>

        </div>
    </div>

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <!-- Login JS -->
    <script src="~/js/login.js"></script>

</body>
</html>
